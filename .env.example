# Copy to .env and enter your LLM API base URL and key. Do not commit .env.
# OpenAI-compatible base URL, excluding /chat/completions.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen-3.7-flash

# Local Python embedding model (downloaded on first use).
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional application settings.
# DATABASE_PATH=./data.db
RETRIEVAL_MIN_SCORE=0.30
CHUNK_THRESHOLD=0.55
